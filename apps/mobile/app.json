{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "version": "2.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "lifeos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "il.co.ozavrahami.lifeos",
      "buildNumber": "10"
    },
    "android": {
      "package": "com.lifeos.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
