{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "version": "0.2.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "lifeos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "il.co.ozavrahami.lifeos",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.lifeos.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-splash-screen",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
